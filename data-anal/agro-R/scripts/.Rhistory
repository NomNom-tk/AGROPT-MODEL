library(ggplot2)
library(tidyverse)
library(dplyr)
# csv import for debate level and agent-level
# MAKE SURE IT IS THE BATCH FILE AND NOT AGENT !!!!
df_batch <- read.csv("../data/batch_summary.csv")
# basic exploration
# use nrow to check rows, what type of model, unique debates, distribution of conditions
nrow(df_batch)
nrow(df_ag)
View(df_batch)
print(tab_bip_check)
tab_bip_check <- df_ag %>%
group_by(neutral_zone_width)
tab_bip_check <- df_batch %>%
group_by(neutral_zone_width)
View(tab_bip_check)
stochasticity_check <- df_batch %>%
group_by(model_type, selected_debate_id, convergence_rate,
confidence_threshold, repulsion_threshold, repulsion_strength) %>%
summarize(
mae_mean = mean(mae),
mae_sd = sd(mae),
mae_min = min(mae),
mae_max = max(mae),
n_seeds = n(),
.groups = 'drop'
)
View(stochasticity_check)
# min and max stochasticity
max(stochasticity_check$mae_sd, na.rm = TRUE)
min(stochasticity_check$mae_sd, na.rm = TRUE)
