write_csv(pro_vs_anti, "./results/agent-pro-vs-anti.csv")
View(opin_compar)
# which agents are leaders?
agent_leaders <- df_ag %>%
mutate(abs_opinion_change = abs(opinion_change)) %>%
group_by(agent_id, model_type) %>%
summarize(
