mutate(initial_position = cut(initial_opinion,
breaks = c(0, 0.33, 0.67, 1),
labels = c("Anti", "Moderate", "Pro"))) %>%
group_by(initial_position, model_type) %>%
summarize(mean_error = mean(individual_error))
View(opin_compar)
